diff --git a/drivers/cpufreq/tegra210-cpufreq.c b/drivers/cpufreq/tegra210-cpufreq.c
index 7c4ded1..0ed78ec 100644
--- a/drivers/cpufreq/tegra210-cpufreq.c
+++ b/drivers/cpufreq/tegra210-cpufreq.c
@@ -206,6 +206,7 @@ dfll_fail:
 
 static int cpufreq_table_make_from_dt(void)
 {
+	static const u32 foster_oc_freqs[] = { 2116500, 2218500 };
 	struct tegra_cpufreq_table_data *tftbl = &tfreq_priv->tfrqtbl;
 	struct device *dev = &tfreq_priv->pdev->dev;
 	struct cpufreq_frequency_table *ftbl;
@@ -264,6 +265,18 @@ static int cpufreq_table_make_from_dt(void)
 			i++;
 		}
 	}
+
+	/* Shield 9.2.x DT stops at 2.0145 GHz; expose accepted OC OPPs. */
+	for (j = 0; j < ARRAY_SIZE(foster_oc_freqs); j++) {
+		if (i < CPU_FREQ_TABLE_MAX_SIZE - 1 &&
+		    (!i || ftbl[i - 1].frequency < foster_oc_freqs[j]) &&
+		    clk_round_rate(tfreq_priv->cpu_clk,
+				   foster_oc_freqs[j] * 1000) > 0) {
+			ftbl[i].driver_data = 0;
+			ftbl[i].frequency = foster_oc_freqs[j];
+			i++;
+		}
+	}
 	ftbl[i].driver_data = 0;
 	ftbl[i].frequency = CPUFREQ_TABLE_END;
 	tftbl->freq_table = ftbl;
